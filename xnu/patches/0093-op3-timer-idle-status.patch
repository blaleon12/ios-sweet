+/*
+ * OP3 bring-up status line: slot n shows "<tag>:XXXXXXXX" at the top right,
+ * drawn straight into the framebuffer (no console state, no locks), so it
+ * can be called from the timer interrupt and the idle loop. Kicks only when
+ * the link is idle and never waits.
+ */
+void sweet_fbcon_status(unsigned int slot, char tag, uint32_t value);
+
+static void
+fbcon_glyph_at(uint32_t x0, uint32_t y0, unsigned char c)
+{
+	const unsigned char *glyph = iso_font + c * 16;
+	for (uint32_t gy = 0; gy < 16; gy++) {
+		for (uint32_t sy = 0; sy < FBCON_SCALE; sy++) {
+			for (uint32_t gx = 0; gx < 8; gx++) {
+				uint32_t px = (glyph[gy] & (1u << gx)) ? 0xff00ffffu : FBCON_BG;
+				for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
+					fbcon_px(x0 + gx * FBCON_SCALE + sx, y0 + gy * FBCON_SCALE + sy, px);
+				}
+			}
+		}
+	}
+}
+
+void
+sweet_fbcon_status(unsigned int slot, char tag, uint32_t value)
+{
+	const uint32_t cw = 8 * FBCON_SCALE, chars = 11;   /* "T:XXXXXXXX " */
+	if (fbcon_base == NULL || (slot + 1) * chars * cw > fbcon_width) {
+		return;
+	}
+	uint32_t x = fbcon_width - (slot + 1) * chars * cw;
+	fbcon_glyph_at(x, 0, (unsigned char)tag);
+	fbcon_glyph_at(x + cw, 0, ':');
+	for (int i = 0; i < 8; i++) {
+		unsigned d = (value >> (28 - 4 * i)) & 0xf;
+		fbcon_glyph_at(x + (2 + i) * cw, 0, (unsigned char)(d < 10 ? '0' + d : 'A' + d - 10));
+	}
+	if (fbcon_kick_regs != NULL && (fbcon_busy_reg == NULL || !(*fbcon_busy_reg & fbcon_busy_mask))) {
+		__asm__ volatile("dsb sy" ::: "memory");
+		fbcon_kick_regs[0x18 / 4] = fbcon_kick_flush;
+		__asm__ volatile("dsb sy" ::: "memory");
+		fbcon_kick_regs[0x1c / 4] = 1;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
