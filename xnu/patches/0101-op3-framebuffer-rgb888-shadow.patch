+extern "C" bool sweet_fbcon_panel_kick(void);   /* pexpert/arm/pe_serial.c */
+
+/*
+ * Shadow mode: copy the BGRA shadow into the RGB888 panel memory (bytes
+ * B,G,R: drop every 4th byte), 8 pixels = 24 bytes as three 64-bit stores,
+ * then kick the command-mode panel.
+ */
+void
+AppleCLCD::flushPanel(void)
+{
+	if (!fShadow) {
+		return;
+	}
+	for (uint32_t y = 0; y < fHeight; y++) {
+		const uint32_t *s = (const uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
+		volatile uint8_t *d = (volatile uint8_t *)(fPanel + (uint64_t)y * fPanelRowBytes);
+		uint32_t x = 0;
+		for (; x + 8 <= fWidth; x += 8, s += 8, d += 24) {
+			uint64_t p0 = s[0] & 0xffffff, p1 = s[1] & 0xffffff, p2 = s[2] & 0xffffff;
+			uint64_t p3 = s[3] & 0xffffff, p4 = s[4] & 0xffffff, p5 = s[5] & 0xffffff;
+			uint64_t p6 = s[6] & 0xffffff, p7 = s[7] & 0xffffff;
+			volatile uint64_t *q = (volatile uint64_t *)d;
+			q[0] = p0 | p1 << 24 | p2 << 48;
+			q[1] = p2 >> 16 | p3 << 8 | p4 << 32 | p5 << 56;
+			q[2] = p5 >> 8 | p6 << 16 | p7 << 40;
+		}
+		for (; x < fWidth; x++, s++, d += 3) {
+			d[0] = (uint8_t)*s;
+			d[1] = (uint8_t)(*s >> 8);
+			d[2] = (uint8_t)(*s >> 16);
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	(void)sweet_fbcon_panel_kick();
+}
