+/*
+ * OnePlus 3 (MSM8996) input: Synaptics S3320 touch screen and the
+ * power / volume keys, feeding SweetHID (iokit/Kernel/arm/hid/SweetHID.cpp)
+ * through sweet_hid_touch() / sweet_hid_key(). Everything is polled on one
+ * kernel thread; no interrupts are wired up.
+ *
+ * Hardware (stock OnePlus 3 device tree):
+ *   touch   S3320 (RMI4 over I2C) at 0x20 on BLSP2 QUP6 = blsp_i2c12
+ *           (0x075ba000, SDA/SCL = TLMM GPIO 87/88 function 3), IRQ GPIO 125
+ *           (low active), reset GPIO 89, 1.8 V enable GPIO 49,
+ *           2.8 V = PM8994 L22 (RPM-owned), 1.8 V I2C = PM8994 S4 (always on)
+ *   keys    power = PM8994 PON (SID 0, 0x800) RT status bit 0,
+ *           volume up / down = PM8994 GPIO 3 / 2 (SID 0, 0xc200 / 0xc100),
+ *           low active
+ * PMIC access goes through the SPMI PMIC arbiter v2 observer channels
+ * (read only). The single PMIC write (L22 enable) needs op3touch=2.
+ *
+ * On by default only with LK's 1080x1920 RGB888 boot framebuffer (OnePlus 3).
+ * Boot-args: op3keys=0 / op3touch=0 disable, op3touch=2 also enables L22 if
+ * it is off, op3i2chz=N bus speed (default 100000), op3touchlog=N logs the
+ * first N touch reports raw.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void op3_input_init(void);
+
+/* ---- MMIO ---- */
+
+#define OP3_TLMM_PA      0x01010000u
+#define OP3_TLMM_SIZE    0x00300000u
+#define OP3_GCC_PA       0x00300000u
+#define OP3_GCC_SIZE     0x00060000u
+#define OP3_QUP_PA       0x075ba000u
+#define OP3_ARB_CORE_PA  0x0400f000u
+#define OP3_ARB_CHNL_PA  0x04400000u
+#define OP3_ARB_OBS_PA   0x04c00000u
+
+static vm_offset_t op3_tlmm, op3_gcc, op3_qup, op3_core;
+
+static inline uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static void
+op3_sleep_ms(uint32_t ms)
+{
+	static int chan;
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- TLMM ---- */
+
+#define TLMM_CFG(n)     ((uint32_t)(n) * 0x1000u)
+#define TLMM_IO(n)      (TLMM_CFG(n) + 4u)
+#define TLMM_PULL_UP    3u
+#define TLMM_FUNC(f)    ((uint32_t)(f) << 2)
+#define TLMM_DRV(ma)    ((uint32_t)((ma) / 2 - 1) << 6)
+#define TLMM_OE         (1u << 9)
+
+#define GPIO_I2C_SDA    87
+#define GPIO_I2C_SCL    88
+#define GPIO_TS_1V8     49
+#define GPIO_TS_RESET   89
+#define GPIO_TS_IRQ     125
+
+static void
+gpio_out(unsigned n, int v)
+{
+	wr32(op3_tlmm, TLMM_IO(n), v ? 2u : 0u);
+	wr32(op3_tlmm, TLMM_CFG(n), TLMM_PULL_UP | TLMM_FUNC(0) | TLMM_DRV(16) | TLMM_OE);
+}
+
+static int
+gpio_in(unsigned n)
+{
+	return (int)(rd32(op3_tlmm, TLMM_IO(n)) & 1u);
+}
+
+/* ---- SPMI PMIC arbiter v2 (read through observer channels) ---- */
+
+#define ARB_CMD         0x00u
+#define ARB_STATUS      0x08u
+#define ARB_WDATA0      0x10u
+#define ARB_RDATA0      0x18u
+#define ARB_OP_WRITEL   0u
+#define ARB_OP_READL    1u
+#define ARB_NO_APID     0xffffu
+
+struct op3_periph {
+	uint16_t ppid;          /* sid << 8 | peripheral */
+	uint16_t apid;
+	vm_offset_t obs, chnl;
+};
+
+enum { P_PON, P_VOLDN, P_VOLUP, P_L22, P_COUNT };
+static struct op3_periph op3_pmic[P_COUNT] = {
+	[P_PON]   = { 0x008, ARB_NO_APID, 0, 0 },
+	[P_VOLDN] = { 0x0c1, ARB_NO_APID, 0, 0 },
+	[P_VOLUP] = { 0x0c2, ARB_NO_APID, 0, 0 },
+	[P_L22]   = { 0x155, ARB_NO_APID, 0, 0 },
+};
+static uint32_t op3_arb_status;
+
+static bool
+arb_wait(vm_offset_t ch)
+{
+	for (int i = 0; i < 1000; i++) {
+		uint32_t st = rd32(ch, ARB_STATUS);
+		if (st & 1u) {
+			op3_arb_status = st;
+			return (st & 0xeu) == 0;
+		}
+		delay(1);
+	}
+	op3_arb_status = 0xffffffffu;
+	return false;
+}
+
+static bool
+pmic_read(int p, uint8_t off, uint8_t *val)
+{
+	vm_offset_t ch = op3_pmic[p].obs;
+	if (ch == 0) {
+		return false;
+	}
+	wr32(ch, ARB_CMD, (ARB_OP_READL << 27) | ((uint32_t)off << 4));
+	if (!arb_wait(ch)) {
+		return false;
+	}
+	*val = (uint8_t)rd32(ch, ARB_RDATA0);
+	return true;
+}
+
+static bool
+pmic_write(int p, uint8_t off, uint8_t val)
+{
+	vm_offset_t ch = op3_pmic[p].chnl;
+	if (ch == 0) {
+		return false;
+	}
+	wr32(ch, ARB_WDATA0, val);
+	wr32(ch, ARB_CMD, (ARB_OP_WRITEL << 27) | ((uint32_t)off << 4));
+	return arb_wait(ch);
+}
+
+static bool
+pmic_setup(void)
+{
+	uint32_t ver = rd32(op3_core, 0);
+	unsigned found = 0;
+	for (uint16_t apid = 0; apid < 256; apid++) {
+		uint32_t v = rd32(op3_core, 0x800u + 4u * apid);
+		if (v == 0) {
+			continue;
+		}
+		uint16_t ppid = (uint16_t)((v >> 8) & 0xfffu);
+		for (int p = 0; p < P_COUNT; p++) {
+			if (op3_pmic[p].ppid == ppid && op3_pmic[p].apid == ARB_NO_APID) {
+				op3_pmic[p].apid = apid;
+				op3_pmic[p].obs = ml_io_map(OP3_ARB_OBS_PA + 0x8000u * apid, 0x1000);
+				found++;
+			}
+		}
+	}
+	printf("OP3 IN: PMIC arbiter version %#x, pon apid %d, vol-/+ apid %d/%d, l22 apid %d\n",
+	    ver, op3_pmic[P_PON].apid, op3_pmic[P_VOLDN].apid, op3_pmic[P_VOLUP].apid,
+	    op3_pmic[P_L22].apid);
+	return ver >= 0x20010000u && ver < 0x30000000u && found > 0;
+}
+
+/* ---- QUP I2C (v2 tags, FIFO mode, polled) ---- */
+
+#define QUP_CONFIG              0x000u
+#define QUP_STATE               0x004u
+#define QUP_IO_MODE             0x008u
+#define QUP_SW_RESET            0x00cu
+#define QUP_OPERATIONAL         0x018u
+#define QUP_ERROR_FLAGS         0x01cu
+#define QUP_HW_VERSION          0x030u
+#define QUP_MX_OUTPUT_CNT       0x100u
+#define QUP_OUT_FIFO            0x110u
+#define QUP_MX_WRITE_CNT        0x150u
+#define QUP_MX_INPUT_CNT        0x200u
+#define QUP_MX_READ_CNT         0x208u
+#define QUP_IN_FIFO             0x218u
+#define QUP_I2C_CLK_CTL         0x400u
+#define QUP_I2C_STATUS          0x404u
+#define QUP_I2C_MASTER_GEN      0x408u
+
+#define QUP_ST_RESET            0u
+#define QUP_ST_RUN              1u
+#define QUP_ST_PAUSE            3u
+#define QUP_ST_VALID            (1u << 2)
+#define QUP_ST_MAST_GEN         (1u << 4)
+#define QUP_OP_OUT_NOT_EMPTY    (1u << 4)
+#define QUP_OP_IN_NOT_EMPTY     (1u << 5)
+#define QUP_OP_SVC_FLAGS        (3u << 8)
+#define QUP_OP_OUTPUT_DONE      (1u << 10)
+#define QUP_CFG_I2C             ((2u << 8) | 7u)
+#define QUP_CFG_NO_INPUT        (1u << 7)
+#define QUP_IO_REPACK           (3u << 14)
+#define I2C_ST_NACK             (1u << 3)
+#define I2C_ST_BUS_ACTIVE       (1u << 8)
+#define I2C_ST_ERRORS           0x38000fcu
+
+#define TAG_START               0x81u
+#define TAG_WR                  0x82u
+#define TAG_WR_STOP             0x83u
+#define TAG_RD_STOP             0x87u
+
+static uint32_t op3_clk_ctl;
+static uint32_t op3_i2c_err;    /* last I2C_STATUS / ERROR_FLAGS on failure */
+
+static bool
+qup_state(uint32_t state)
+{
+	for (int i = 0; i < 1000; i++) {
+		uint32_t s = rd32(op3_qup, QUP_STATE);
+		if ((s & QUP_ST_VALID) && (s & 3u) == state) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+qup_set_state(uint32_t state)
+{
+	wr32(op3_qup, QUP_STATE, state);
+	return qup_state(state);
+}
+
+/*
+ * One bus transaction from a tag stream: tx = tags + data (<= 32 bytes),
+ * rx = bytes requested by a single DATA_RD_STOP tag (<= 252), received
+ * after two tag bytes.
+ */
+static bool
+qup_xfer(const uint8_t *tx, uint32_t txlen, uint8_t *rx, uint32_t rxlen)
+{
+	uint32_t total_rx = rxlen ? rxlen + 2u : 0u, got = 0, op = 0;
+	bool ok = false;
+
+	wr32(op3_qup, QUP_SW_RESET, 1);
+	if (!qup_state(QUP_ST_RESET)) {
+		op3_i2c_err = 0xdead0001u;
+		return false;
+	}
+	wr32(op3_qup, QUP_CONFIG, QUP_CFG_I2C);
+	wr32(op3_qup, QUP_I2C_MASTER_GEN, 1);   /* v2 tags */
+	wr32(op3_qup, QUP_IO_MODE, QUP_IO_REPACK);
+	wr32(op3_qup, QUP_MX_OUTPUT_CNT, 0);
+	wr32(op3_qup, QUP_MX_INPUT_CNT, 0);
+	wr32(op3_qup, QUP_MX_WRITE_CNT, txlen);
+	wr32(op3_qup, QUP_MX_READ_CNT, total_rx);
+	wr32(op3_qup, QUP_CONFIG, QUP_CFG_I2C | (rxlen ? 0u : QUP_CFG_NO_INPUT));
+	if (!qup_set_state(QUP_ST_RUN)) {
+		op3_i2c_err = 0xdead0002u;
+		goto out;
+	}
+	wr32(op3_qup, QUP_I2C_CLK_CTL, op3_clk_ctl);
+	if (!qup_set_state(QUP_ST_PAUSE)) {
+		op3_i2c_err = 0xdead0003u;
+		goto out;
+	}
+	for (uint32_t i = 0; i < txlen; i += 4) {
+		uint32_t w = 0;
+		for (uint32_t j = 0; j < 4 && i + j < txlen; j++) {
+			w |= (uint32_t)tx[i + j] << (8 * j);
+		}
+		wr32(op3_qup, QUP_OUT_FIFO, w);
+	}
+	if (!qup_set_state(QUP_ST_RUN)) {
+		op3_i2c_err = 0xdead0004u;
+		goto out;
+	}
+	for (int t = 0; t < 50000; t++) {       /* ~50 ms */
+		uint32_t st = rd32(op3_qup, QUP_I2C_STATUS);
+		uint32_t ef = rd32(op3_qup, QUP_ERROR_FLAGS);
+		if ((st & I2C_ST_ERRORS) || (ef & 0x7cu)) {
+			op3_i2c_err = (st & 0xffffffu) | ((ef & 0x7cu) << 24);
+			goto out;
+		}
+		op = rd32(op3_qup, QUP_OPERATIONAL);
+		if (op & QUP_OP_SVC_FLAGS) {
+			wr32(op3_qup, QUP_OPERATIONAL, op & QUP_OP_SVC_FLAGS);
+		}
+		while ((op & QUP_OP_IN_NOT_EMPTY) && got < total_rx) {
+			uint32_t w = rd32(op3_qup, QUP_IN_FIFO);
+			for (uint32_t j = 0; j < 4 && got < total_rx; j++, got++) {
+				if (got >= 2) {
+					rx[got - 2] = (uint8_t)(w >> (8 * j));
+				}
+			}
+			op = rd32(op3_qup, QUP_OPERATIONAL);
+		}
+		if (rxlen ? got >= total_rx :
+		    ((op & QUP_OP_OUTPUT_DONE) && !(op & QUP_OP_OUT_NOT_EMPTY) &&
+		    !(st & I2C_ST_BUS_ACTIVE))) {
+			ok = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!ok && op3_i2c_err == 0) {
+		op3_i2c_err = 0xdead0005u | (got << 8);
+	}
+out:
+	if (!ok) {
+		wr32(op3_qup, QUP_SW_RESET, 1);
+		(void)qup_state(QUP_ST_RESET);
+		return false;
+	}
+	for (int t = 0; t < 1000 && (rd32(op3_qup, QUP_I2C_STATUS) & I2C_ST_BUS_ACTIVE); t++) {
+		delay(1);
+	}
+	(void)qup_set_state(QUP_ST_RESET);
+	return true;
+}
+
+#define TS_ADDR         0x20u
+
+static bool
+i2c_read(uint8_t reg, uint8_t *buf, uint32_t len)
+{
+	const uint8_t tx[9] = {
+		TAG_START, TS_ADDR << 1, TAG_WR, 1, reg,
+		TAG_START, (TS_ADDR << 1) | 1, TAG_RD_STOP, (uint8_t)len,
+	};
+	op3_i2c_err = 0;
+	return qup_xfer(tx, sizeof(tx), buf, len);
+}
+
+static bool
+i2c_write(uint8_t reg, const uint8_t *buf, uint32_t len)
+{
+	uint8_t tx[32];
+	if (len > sizeof(tx) - 5) {
+		return false;
+	}
+	tx[0] = TAG_START;
+	tx[1] = TS_ADDR << 1;
+	tx[2] = TAG_WR_STOP;
+	tx[3] = (uint8_t)(len + 1);
+	tx[4] = reg;
+	for (uint32_t i = 0; i < len; i++) {
+		tx[5 + i] = buf[i];
+	}
+	op3_i2c_err = 0;
+	return qup_xfer(tx, 5 + len, NULL, 0);
+}
+
+/* ---- RMI4 ---- */
+
+#define RMI_PAGE_SELECT 0xffu
+#define RMI_PDT_START   0xe9u
+#define TS_FINGERS      10u
+
+static uint16_t f01_data = 0xffff, f01_ctrl = 0xffff, f01_query = 0xffff;
+static uint16_t f12_data = 0xffff, f12_ctrl = 0xffff, f12_query = 0xffff;
+static uint8_t op3_page = 0xff;
+
+static bool
+rmi_read(uint16_t addr, uint8_t *buf, uint32_t len)
+{
+	uint8_t page = (uint8_t)(addr >> 8);
+	if (page != op3_page) {
+		if (!i2c_write(RMI_PAGE_SELECT, &page, 1)) {
+			op3_page = 0xff;
+			return false;
+		}
+		op3_page = page;
+	}
+	return i2c_read((uint8_t)addr, buf, len);
+}
+
+static bool
+rmi_scan(void)
+{
+	for (uint16_t page = 0; page < 4; page++) {
+		bool any = false;
+		for (uint16_t a = RMI_PDT_START; a >= 0x0a; a -= 6) {
+			uint8_t e[6];
+			if (!rmi_read((uint16_t)(page << 8 | a), e, 6)) {
+				printf("OP3 IN: PDT read page %u addr %#x failed (i2c %#x)\n",
+				    page, a, op3_i2c_err);
+				return false;
+			}
+			if (e[5] == 0 || e[5] == 0xff) {
+				break;
+			}
+			any = true;
+			printf("OP3 IN: RMI F%02x page %u query %#x cmd %#x ctrl %#x data %#x irqs %u\n",
+			    e[5], page, e[0], e[1], e[2], e[3], e[4] & 7u);
+			uint16_t base = (uint16_t)(page << 8);
+			if (e[5] == 0x01) {
+				f01_query = base | e[0];
+				f01_ctrl = base | e[2];
+				f01_data = base | e[3];
+			} else if (e[5] == 0x12) {
+				f12_query = base | e[0];
+				f12_ctrl = base | e[2];
+				f12_data = base | e[3];
+			}
+		}
+		if (!any) {
+			break;
+		}
+	}
+	return f01_data != 0xffff && f12_data != 0xffff;
+}
+
+/* ---- bring-up ---- */
+
+static int op3_touch_mode, op3_keys_on, op3_touch_log = 40;
+static bool op3_touch_ok;
+
+static bool
+clocks_on(void)
+{
+	/* GCC: BLSP2 AHB (vote), QUP6 I2C core clock (from XO 19.2 MHz) */
+	uint32_t vote = rd32(op3_gcc, 0x52004);
+	uint32_t ahb = rd32(op3_gcc, 0x25004);
+	uint32_t cbcr = rd32(op3_gcc, 0x30008);
+	uint32_t rcg = rd32(op3_gcc, 0x30020), cfg = rd32(op3_gcc, 0x30024);
+	printf("OP3 IN: gcc vote %#x blsp2-ahb %#x qup6-i2c %#x rcg %#x cfg %#x\n",
+	    vote, ahb, cbcr, rcg, cfg);
+	wr32(op3_gcc, 0x52004, vote | (1u << 15));
+	wr32(op3_gcc, 0x30008, cbcr | 1u);
+	for (int i = 0; i < 1000; i++) {
+		if (!(rd32(op3_gcc, 0x25004) & (1u << 31)) && !(rd32(op3_gcc, 0x30008) & (1u << 31))) {
+			printf("OP3 IN: clocks on: blsp2-ahb %#x qup6-i2c %#x\n",
+			    rd32(op3_gcc, 0x25004), rd32(op3_gcc, 0x30008));
+			return true;
+		}
+		delay(10);
+	}
+	printf("OP3 IN: clocks stay off: blsp2-ahb %#x qup6-i2c %#x\n",
+	    rd32(op3_gcc, 0x25004), rd32(op3_gcc, 0x30008));
+	return false;
+}
+
+static void
+l22_check(void)
+{
+	uint8_t st = 0, en = 0, v0 = 0, v1 = 0, mode = 0;
+	bool ok = pmic_read(P_L22, 0x08, &st) && pmic_read(P_L22, 0x46, &en) &&
+	    pmic_read(P_L22, 0x40, &v0) && pmic_read(P_L22, 0x41, &v1) &&
+	    pmic_read(P_L22, 0x45, &mode);
+	printf("OP3 IN: L22 read %s status %#x en %#x vset %#x/%#x mode %#x (arb %#x)\n",
+	    ok ? "ok" : "FAILED", st, en, v0, v1, mode, op3_arb_status);
+	if (!ok || (en & 0x80u) || op3_touch_mode < 2) {
+		return;
+	}
+	op3_pmic[P_L22].chnl = ml_io_map(OP3_ARB_CHNL_PA + 0x8000u * op3_pmic[P_L22].apid, 0x1000);
+	bool w = pmic_write(P_L22, 0x46, 0x80);
+	op3_sleep_ms(5);
+	(void)pmic_read(P_L22, 0x46, &en);
+	(void)pmic_read(P_L22, 0x08, &st);
+	printf("OP3 IN: L22 enable write %s (arb %#x): en %#x status %#x\n",
+	    w ? "ok" : "FAILED", op3_arb_status, en, st);
+}
+
+static bool
+touch_bringup(void)
+{
+	printf("OP3 IN: tlmm before: 49 %#x/%#x 87 %#x 88 %#x 89 %#x/%#x 125 %#x/%#x\n",
+	    rd32(op3_tlmm, TLMM_CFG(49)), rd32(op3_tlmm, TLMM_IO(49)),
+	    rd32(op3_tlmm, TLMM_CFG(87)), rd32(op3_tlmm, TLMM_CFG(88)),
+	    rd32(op3_tlmm, TLMM_CFG(89)), rd32(op3_tlmm, TLMM_IO(89)),
+	    rd32(op3_tlmm, TLMM_CFG(125)), rd32(op3_tlmm, TLMM_IO(125)));
+	if (!clocks_on()) {
+		return false;
+	}
+	printf("OP3 IN: QUP hw version %#x state %#x io-mode %#x\n",
+	    rd32(op3_qup, QUP_HW_VERSION), rd32(op3_qup, QUP_STATE), rd32(op3_qup, QUP_IO_MODE));
+	l22_check();
+
+	/* pins: I2C function 3, IRQ input with pull-up, power + reset outputs */
+	wr32(op3_tlmm, TLMM_CFG(GPIO_I2C_SDA), TLMM_FUNC(3) | TLMM_DRV(2));
+	wr32(op3_tlmm, TLMM_CFG(GPIO_I2C_SCL), TLMM_FUNC(3) | TLMM_DRV(2));
+	wr32(op3_tlmm, TLMM_CFG(GPIO_TS_IRQ), TLMM_PULL_UP | TLMM_FUNC(0) | TLMM_DRV(16));
+
+	/* Is it already alive (LK powered it)? Then do not reset. */
+	uint8_t e[6];
+	bool alive = i2c_read(RMI_PDT_START, e, 6);
+	printf("OP3 IN: S3320 probe before power-up: %s (i2c %#x) pdt %02x %02x %02x %02x %02x %02x\n",
+	    alive ? "ACK" : "no answer", op3_i2c_err, e[0], e[1], e[2], e[3], e[4], e[5]);
+	if (!alive) {
+		gpio_out(GPIO_TS_1V8, 1);
+		gpio_out(GPIO_TS_RESET, 0);
+		op3_sleep_ms(20);
+		gpio_out(GPIO_TS_RESET, 1);
+		op3_sleep_ms(250);
+		alive = i2c_read(RMI_PDT_START, e, 6);
+		printf("OP3 IN: S3320 probe after power-up: %s (i2c %#x) irq-gpio %d\n",
+		    alive ? "ACK" : "no answer", op3_i2c_err, gpio_in(GPIO_TS_IRQ));
+		if (!alive) {
+			return false;
+		}
+	}
+	op3_page = 0xff;
+	if (!rmi_scan()) {
+		printf("OP3 IN: no F01/F12 found\n");
+		return false;
+	}
+	uint8_t q[21] = {0}, st[2] = {0}, c[1] = {0};
+	(void)rmi_read(f01_query, q, sizeof(q));
+	(void)rmi_read(f01_data, st, sizeof(st));
+	(void)rmi_read(f01_ctrl, c, 1);
+	char prod[11];
+	for (int i = 0; i < 10; i++) {
+		prod[i] = (q[11 + i] >= 0x20 && q[11 + i] < 0x7f) ? (char)q[11 + i] : '.';
+	}
+	prod[10] = 0;
+	printf("OP3 IN: F01 product \"%s\" status %#x irq %#x ctrl0 %#x irq-gpio %d\n",
+	    prod, st[0], st[1], c[0], gpio_in(GPIO_TS_IRQ));
+	if (c[0] & 3u) {                /* sleep mode -> normal */
+		c[0] &= (uint8_t)~3u;
+		(void)i2c_write((uint8_t)f01_ctrl, c, 1);
+	}
+	uint8_t f12q[16] = {0};
+	(void)rmi_read(f12_query, f12q, sizeof(f12q));
+	printf("OP3 IN: F12 query %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    f12q[0], f12q[1], f12q[2], f12q[3], f12q[4], f12q[5], f12q[6], f12q[7], f12q[8], f12q[9]);
+	return true;
+}
+
+/* F12 object report: 8 bytes per finger: type, x lo/hi, y lo/hi, wx, wy, z */
+static void
+touch_poll(void)
+{
+	static bool down[TS_FINGERS];
+	static unsigned errors;
+	uint8_t irq[2], d[8 * TS_FINGERS];
+
+	if (gpio_in(GPIO_TS_IRQ)) {
+		return;                 /* line high: nothing pending */
+	}
+	if (!rmi_read(f01_data, irq, 2) || !rmi_read(f12_data, d, sizeof(d))) {
+		if ((errors++ % 200u) == 0) {
+			printf("OP3 IN: touch read error i2c %#x\n", op3_i2c_err);
+		}
+		return;
+	}
+	for (unsigned f = 0; f < TS_FINGERS; f++) {
+		const uint8_t *o = &d[8 * f];
+		bool on = o[0] == 1 || o[0] == 2 || o[0] == 6;   /* finger, stylus, glove */
+		int x = o[1] | o[2] << 8, y = o[3] | o[4] << 8;
+		if (op3_touch_log > 0 && (on || down[f])) {
+			op3_touch_log--;
+			printf("OP3 IN: touch f%u type %u x %d y %d w %u/%u z %u irq %#x\n",
+			    f, o[0], x, y, o[5], o[6], o[7], irq[1]);
+		}
+		if (on || down[f]) {
+			sweet_hid_touch((int)f, on, x, y);
+		}
+		down[f] = on;
+	}
+}
+
+static void
+keys_poll(void)
+{
+	static int state[3];
+	uint8_t pon = 0, dn = 0xff, up = 0xff;
+	bool ok = pmic_read(P_PON, 0x10, &pon);
+	ok = pmic_read(P_VOLUP, 0x08, &up) && ok;
+	ok = pmic_read(P_VOLDN, 0x08, &dn) && ok;
+	if (!ok) {
+		return;
+	}
+	/* sweet_hid_key: 0 power, 1 volume up, 2 volume down */
+	int now[3] = { !!(pon & 1u), !(up & 1u), !(dn & 1u) };
+	for (int k = 0; k < 3; k++) {
+		if (now[k] != state[k]) {
+			state[k] = now[k];
+			printf("OP3 IN: key %d %s (pon %#x vol+ %#x vol- %#x)\n",
+			    k, now[k] ? "down" : "up", pon, up, dn);
+			sweet_hid_key(k, now[k]);
+		}
+	}
+}
+
+static void
+op3_input_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	if (op3_touch_mode) {
+		op3_touch_ok = touch_bringup();
+		printf("OP3 IN: touch %s\n", op3_touch_ok ? "running" : "NOT available");
+	}
+	if (op3_keys_on) {
+		uint8_t pon = 0, up = 0, dn = 0;
+		bool ok = pmic_read(P_PON, 0x10, &pon) && pmic_read(P_VOLUP, 0x08, &up) &&
+		    pmic_read(P_VOLDN, 0x08, &dn);
+		printf("OP3 IN: keys %s: pon rt %#x vol+ %#x vol- %#x (arb %#x)\n",
+		    ok ? "running" : "read FAILED", pon, up, dn, op3_arb_status);
+	}
+	for (unsigned tick = 0;; tick++) {
+		if (op3_touch_ok) {
+			touch_poll();
+		}
+		if (op3_keys_on && (tick & 1u) == 0) {
+			keys_poll();
+		}
+		op3_sleep_ms(10);
+	}
+}
+
+void
+op3_input_init(void)
+{
+	static bool started;
+	uint32_t hz = 100000;
+	thread_t thread;
+
+	if (started) {
+		return;
+	}
+	started = true;
+	/* Default on only on the OnePlus 3 (LK's 1080x1920 RGB888 boot framebuffer). */
+	PE_Video video;
+	PE_current_console(&video);
+	op3_touch_mode = op3_keys_on = (video.v_width == 1080 && video.v_height == 1920 &&
+	    video.v_depth == 24) ? 1 : 0;
+	(void)PE_parse_boot_argn("op3touch", &op3_touch_mode, sizeof(op3_touch_mode));
+	(void)PE_parse_boot_argn("op3keys", &op3_keys_on, sizeof(op3_keys_on));
+	(void)PE_parse_boot_argn("op3touchlog", &op3_touch_log, sizeof(op3_touch_log));
+	(void)PE_parse_boot_argn("op3i2chz", &hz, sizeof(hz));
+	if (!op3_touch_mode && !op3_keys_on) {
+		return;
+	}
+	/* QUP clock divider from the 19.2 MHz XO (i2c-qup.c) */
+	if (hz <= 100000) {
+		op3_clk_ctl = (3u << 8) | (((19200000u / hz) / 2u - 3u) & 0xffu);
+	} else {
+		uint32_t fs = ((19200000u / hz) - 6u) * 2u / 3u;
+		op3_clk_ctl = ((fs / 2u) << 16) | (3u << 8) | (fs & 0xffu);
+	}
+	op3_tlmm = ml_io_map(OP3_TLMM_PA, OP3_TLMM_SIZE);
+	op3_gcc = ml_io_map(OP3_GCC_PA, OP3_GCC_SIZE);
+	op3_qup = ml_io_map(OP3_QUP_PA, 0x1000);
+	op3_core = ml_io_map(OP3_ARB_CORE_PA, 0x1000);
+	if (!op3_tlmm || !op3_gcc || !op3_qup || !op3_core) {
+		printf("OP3 IN: MMIO mapping failed\n");
+		return;
+	}
+	if (!pmic_setup()) {
+		printf("OP3 IN: PMIC arbiter not usable, keys off\n");
+		op3_keys_on = 0;
+	}
+	printf("OP3 IN: start touch=%d keys=%d i2c %u Hz clk-ctl %#x\n",
+	    op3_touch_mode, op3_keys_on, hz, op3_clk_ctl);
+	kern_return_t kr = kernel_thread_start(op3_input_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("OP3 IN: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
