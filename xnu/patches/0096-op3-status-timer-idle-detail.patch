+	const uint32_t per_row = fbcon_width / (chars * cw);
+	if (slot >= per_row * FBCON_STATUS_ROWS) {
+		return;
+	}
+	uint32_t x = fbcon_width - (slot % per_row + 1) * chars * cw;
+	uint32_t y = (slot / per_row) * ch;
+	fbcon_glyph_at(x, y, (unsigned char)tag);
+	fbcon_glyph_at(x + cw, y, ':');
 	for (int i = 0; i < 8; i++) {
 		unsigned d = (value >> (28 - 4 * i)) & 0xf;
-		fbcon_glyph_at(x + (2 + i) * cw, 0, (unsigned char)(d < 10 ? '0' + d : 'A' + d - 10));
+		fbcon_glyph_at(x + (2 + i) * cw, y, (unsigned char)(d < 10 ? '0' + d : 'A' + d - 10));
 	}
 	if (fbcon_kick_regs != NULL && (fbcon_busy_reg == NULL || !(*fbcon_busy_reg & fbcon_busy_mask))) {
 		__asm__ volatile("dsb sy" ::: "memory");
@@ -844,10 +850,11 @@ fbcon_clear_row(uint32_t row)
 static void
 fbcon_newline(void)
 {
+	/* OP3 bring-up: rows 0-1 are the status area (sweet_fbcon_status) */
 	fbcon_col = 0;
-	fbcon_row = (fbcon_row + 1) % fbcon_rows;
+	fbcon_row = fbcon_row + 1 < fbcon_rows ? fbcon_row + 1 : FBCON_STATUS_ROWS;
 	fbcon_clear_row(fbcon_row);
-	fbcon_clear_row((fbcon_row + 1) % fbcon_rows);
+	fbcon_clear_row(fbcon_row + 1 < fbcon_rows ? fbcon_row + 1 : FBCON_STATUS_ROWS);
 	fbcon_kick();
 }
 
@@ -856,7 +863,8 @@ fbcon_init(void)
 {
 	fbcon_cols = fbcon_width / (8 * FBCON_SCALE);
 	fbcon_rows = fbcon_height / (16 * FBCON_SCALE);
-	fbcon_col = fbcon_row = 0;
+	fbcon_col = 0;
+	fbcon_row = FBCON_STATUS_ROWS;
 	for (uint32_t r = 0; r < fbcon_rows; r++) {
 		fbcon_clear_row(r);
 	}
