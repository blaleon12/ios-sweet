diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..a8f374d 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -272,8 +272,16 @@ _pfz_trylock_and_enqueue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	// Try to grab the lock
-	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+	// Try to grab the lock. OnePlus 3 (ARMv8.0, no LSE): LL/SC instead of
+	// "casa w10, w11, [x3]"; w10 = old value (0 = we took the lock).
+Ltrylock_enqueue_cas:
+	ldaxr	w10, [x3]		 // load-acquire exclusive
+	cbnz	w10, Ltrylock_enqueue_busy
+	stxr	w9, w11, [x3]
+	cbnz	w9, Ltrylock_enqueue_cas // lost the reservation: retry
+	b		Ltrylock_enqueue_success
+Ltrylock_enqueue_busy:
+	clrex
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +331,15 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+	// OnePlus 3 (ARMv8.0, no LSE): LL/SC instead of "casa w10, w11, [x2]"
+Ltrylock_dequeue_cas:
+	ldaxr	w10, [x2]		 // load-acquire exclusive
+	cbnz	w10, Ltrylock_dequeue_busy
+	stxr	w9, w11, [x2]
+	cbnz	w9, Ltrylock_dequeue_cas // lost the reservation: retry
+	b		Ltrylock_dequeue_success
+Ltrylock_dequeue_busy:
+	clrex
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
