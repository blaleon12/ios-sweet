+/*
+ * One layer in scaled mode: source rect (sx,sy) w x h at logical (dx,dy),
+ * nearest neighbour into the panel window fScaledX..+fScaledW x fHeight.
+ * Panel row py shows logical row py * fLogicalH / fHeight (fColMap the same
+ * for columns), so a logical rect [d, d+n) covers the panel pixels
+ * [ceil(d * H / LH), ceil((d + n) * H / LH)).
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, uintptr_t src, uint32_t bpe, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	const uint32_t H = fHeight, LH = fLogicalH;
+
+	if (src == 0 || bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    s->memory == NULL) {
+		return;
+	}
+	if (w <= 0 || h <= 0) {
+		w = (int32_t)s->width;
+		h = (int32_t)s->height;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+	    (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	uint32_t py0 = (uint32_t)(((uint64_t)dy * H + LH - 1) / LH);
+	uint32_t py1 = (uint32_t)(((uint64_t)(dy + h) * H + LH - 1) / LH);
+	uint32_t cx0 = (uint32_t)(((uint64_t)dx * H + LH - 1) / LH);
+	uint32_t cx1 = (uint32_t)(((uint64_t)(dx + w) * H + LH - 1) / LH);
+	if (py1 > H) {
+		py1 = H;
+	}
+	if (cx1 > fScaledW) {
+		cx1 = fScaledW;
+	}
+	const uintptr_t base = src + s->offset;
+	for (uint32_t py = py0; py < py1; py++) {
+		uint32_t ly = (uint32_t)(((uint64_t)py * LH) / H);
+		if (ly < (uint32_t)dy || ly >= (uint32_t)(dy + h)) {
+			continue;
+		}
+		const uint32_t *srow = (const uint32_t *)(base +
+		    (uint64_t)(sy + (int32_t)ly - dy) * s->bytesPerRow) + (sx - dx);
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes) + fScaledX;
+		for (uint32_t cx = cx0; cx < cx1; cx++) {
+			uint32_t lx = fColMap[cx];
+			if (lx >= (uint32_t)dx && lx < (uint32_t)(dx + w)) {
+				drow[cx] = srow[lx];
+			}
+		}
+	}
+}
