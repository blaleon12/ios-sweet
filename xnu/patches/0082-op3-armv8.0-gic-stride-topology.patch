diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..f3afe2b 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -33,7 +33,7 @@
 #define __ARM_DEBUG__             7
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
-#define __ARM_PAN_AVAILABLE__     1
+/* OnePlus 3 port: the MSM8996 Kryo cores are ARMv8.0 (no PAN, no LSE). */
 #define __ARM_16K_PG__            1
 
 #define HAS_GIC_V3                1
@@ -43,16 +43,16 @@
 #endif /* ! ASSEMBLER */
 
 /*
- * Qualcomm numbers the architected timer PPIs 1/2/3/0 (secure phys, phys,
- * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
- * (CNTV) is INTID 16 + 3 = 19.
+ * The ADT property virtual-timer-intid overrides this default. sweet's
+ * Qualcomm PPI numbering gives 19; the OnePlus 3 (MSM8996) uses the
+ * architected PPI 11 = INTID 27 (measured with op3shim milestone 1).
  */
-#define SWEET_VTIMER_INTID        19
+#define SWEET_VTIMER_INTID        27
 #define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
 
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
 
-#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+#define GICR_PE_SIZE              0x40000 // OnePlus 3: DT redistributor-stride (GICv3 with VLPI frames)
 
 /* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
 #define GICD_CTLR                 0x0
