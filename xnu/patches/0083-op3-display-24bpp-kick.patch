diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..002d6e0 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -514,13 +514,17 @@ LEXT(start_first_cpu)
 	mov		x21, #0
 
 #if defined(SWEET)
-	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	/*
+	 * Stage 0: white 64x32 band at the bottom left, no stack or page tables
+	 * needed. OnePlus 3: RGB888 framebuffer at 0x83400000, stride 3240
+	 * (64 px = 48 words); the kick below makes the command-mode panel show it.
+	 */
+	MOV64	x0, (0x83400000 + 1888 * 3240)
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	mov		x4, #3240
 Lsweet_mark_row:
-	mov		x3, #64
+	mov		x3, #48
 	mov		x5, x0
 Lsweet_mark_pixel:
 	str		w1, [x5], #4
@@ -530,6 +534,14 @@ Lsweet_mark_pixel:
 	subs	x2, x2, #1
 	b.ne	Lsweet_mark_row
 	dsb		sy
+	/* MDP CTL0 kick: FLUSH = VIG0|LM0|DSPP0|CTL, then START */
+	MOV64	x0, 0x902018
+	MOV64	x1, 0x22041
+	str		w1, [x0]
+	dsb		sy
+	mov		w1, #1
+	str		w1, [x0, #4]
+	dsb		sy
 #endif
 
 	// Set low reset vector before attempting any loads
@@ -686,13 +698,16 @@ Lkernelcache_base_found:
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, 0x82000000		/* OnePlus 3: 32MB block holding the fb at 0x83400000 */
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	/* MMIO block at PA 0 (MDP CTL0 at 0x902000) as Device, for the early kick */
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	str		x11, [x13]
 #endif
 
 	/* Ensure TTEs are visible */
