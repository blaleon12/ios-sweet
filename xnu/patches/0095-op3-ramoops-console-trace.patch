diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 2a2b01b..a1beca1 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -869,9 +869,61 @@ fbcon_transmit_ready(void)
 	return 1;
 }
 
+/*
+ * OP3 bring-up: mirror every console byte into the ramoops console zone the
+ * op3shim already writes (Linux persistent_ram: "DBGC", start, size, data).
+ * It survives the forced reset after a hang; read it in TWRP with
+ * cat /sys/fs/pstore/console-ramoops. Optional ADT "ramoops-reg" <phys size>.
+ */
+static volatile uint32_t *ramoops_hdr;
+static uint32_t ramoops_cap;
+
+static void
+ramoops_probe(DTEntry entry)
+{
+	uint64_t const *reg;
+	unsigned int size;
+	if (SecureDTGetProperty(entry, "ramoops-reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 16 || reg[1] < 4096) {
+		return;
+	}
+	volatile uint32_t *h = (volatile uint32_t *)ml_io_map(reg[0], reg[1]);
+	if (h == NULL) {
+		return;
+	}
+	ramoops_cap = (uint32_t)reg[1] - 12;
+	if (h[0] != 0x43474244u || h[2] > ramoops_cap) {   /* no shim log: start fresh */
+		h[0] = 0x43474244u;
+		h[1] = 0;
+		h[2] = 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	ramoops_hdr = h;
+}
+
+static void
+ramoops_putc(uint8_t c)
+{
+	volatile uint32_t *h = ramoops_hdr;
+	if (h == NULL) {
+		return;
+	}
+	uint32_t len = h[2];
+	if (len >= ramoops_cap) {
+		return;
+	}
+	((volatile uint8_t *)h)[12 + len] = c;
+	h[1] = len + 1;
+	h[2] = len + 1;
+	if (c == '\n') {
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
+
 static void
 fbcon_transmit_data(uint8_t c)
 {
+	ramoops_putc(c);
 	if (c == '\r') {
 		fbcon_col = 0;
 		return;
@@ -970,6 +1022,7 @@ fbcon_probe(void)
 			}
 		}
 	}
+	ramoops_probe(entry);
 	sweet_early_mark(17, "fbcon config read; mapping");
 	fbcon_base = (volatile uint8_t *)ml_io_map_wcomb(reg[0], reg[1]);
 	sweet_early_mark(18, "fbcon mapping returned");
