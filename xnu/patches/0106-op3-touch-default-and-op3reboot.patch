+	    op3_reboot_min != 0) {
+		thread_t rt;
+		if (kernel_thread_start(op3_reboot_thread, NULL, &rt) == KERN_SUCCESS) {
+			thread_deallocate(rt);
+			printf("OP3: op3reboot: restart into TWRP after %u min\n", op3_reboot_min);
+		}
+	}
+	/*
