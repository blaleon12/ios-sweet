 	}
 }
 
+/*
+ * Boot-arg op3reboot=N: N minutes after the root device is up, restart into
+ * TWRP (IMEM restart reason 0x77665502 + PSCI SYSTEM_RESET, as the shim
+ * does), so unattended test runs end where the persistent log can be read.
+ * The 15 s pause lets the sweetlog thread (every 10 s) save the last lines.
+ */
+#define OP3_IMEM_PA             0x066bf000u
+#define OP3_IMEM_RESTART_REASON 0x65cu
+#define OP3_RESTART_RECOVERY    0x77665502u
+#define PSCI_SYSTEM_RESET       0x84000009ul
+
+static uint32_t op3_reboot_min;
+
+static void
+op3_reboot_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	for (uint32_t m = 0; m < op3_reboot_min; m++) {
+		op3_sleep_ms(60000);
+	}
+	printf("OP3: op3reboot=%u: restarting into TWRP in 15 s\n", op3_reboot_min);
+	op3_sleep_ms(15000);
+	vm_offset_t imem = ml_io_map(OP3_IMEM_PA, 0x1000);
+	if (imem == 0) {
+		printf("OP3: op3reboot: IMEM mapping failed\n");
+		return;
+	}
+	wr32(imem, OP3_IMEM_RESTART_REASON, OP3_RESTART_RECOVERY);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	register uint64_t x0 __asm__("x0") = PSCI_SYSTEM_RESET;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+	    "x16", "x17", "memory");
+	printf("OP3: op3reboot: PSCI SYSTEM_RESET returned %#llx\n", (unsigned long long)x0);
+}
+
 void
 op3_input_init(void)
 {
@@ -634,11 +674,23 @@ op3_input_init(void)
