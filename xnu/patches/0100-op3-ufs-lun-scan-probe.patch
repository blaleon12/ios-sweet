 	if (error) {
 		return error;
@@ -805,6 +822,19 @@ sweet_log_start(void)
 	}
 }
 
+/*
+ * Boot-arg ufsprobe=1 (OnePlus 3 bring-up): bring the driver up while the
+ * root is still elsewhere (rd=md0), only to report the host state, the LUN
+ * scan and the partition. Read-only unless ufsrw=1; errors are returned.
+ */
+int sweet_ufs_probe(void);
+
+int
+sweet_ufs_probe(void)
+{
+	return su.ready ? 0 : sweet_ufs_init();
+}
