+		error = ENOENT;
+		for (uint32_t lun = 0; lun < 8 && error; lun++) {
+			if (only_lun != UINT32_MAX && lun != only_lun) {
+				continue;
+			}
+			su.lun = (uint8_t)lun;
+			static const uint8_t tur[6] = { 0x00 };
+			/* The first command after the bootloader may report a unit attention. */
+			int terr = 0;
+			for (int i = 0; i < 3 && (terr = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
+			}
+			if (terr) {
+				printf("SWEET UFS: LUN %u not ready (%d)\n", lun, terr);
+				error = terr;
+				continue;
+			}
+			error = ufs_find_partition(want);
 		}
 	}
-	if (!error) {
