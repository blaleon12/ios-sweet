+/* Called from the 100 ms heartbeat interrupt only: push the status area
+ * (and any console text) to the panel if the link is idle; never waits. */
+void sweet_fbcon_status_kick(void);
+void
+sweet_fbcon_status_kick(void)
+{
 	if (fbcon_kick_regs != NULL && (fbcon_busy_reg == NULL || !(*fbcon_busy_reg & fbcon_busy_mask))) {
 		__asm__ volatile("dsb sy" ::: "memory");
 		fbcon_kick_regs[0x18 / 4] = fbcon_kick_flush;
