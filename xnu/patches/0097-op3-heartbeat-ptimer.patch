diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..d277355 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -176,6 +176,15 @@ pe_init_fiq()
 		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0);
 	}
 	gicr_write32(GICR_ISENABLER0, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+	/*
+	 * OP3 bring-up heartbeat: the EL1 physical timer (PPI 14 = INTID 30) is
+	 * unused by XNU. Fire it every 100 ms; sleh_irq only records state and
+	 * re-arms (sweet_heartbeat). Shows where the CPU is even when XNU's own
+	 * timer (CNTV) is no longer programmed.
+	 */
+	gicr_write32(GICR_ISENABLER0, 1U << 30);
+	__builtin_arm_wsr64("S3_3_C14_C2_0", 1920000);   /* CNTP_TVAL_EL0: 100 ms */
+	__builtin_arm_wsr64("S3_3_C14_C2_1", 1);         /* CNTP_CTL_EL0: enable */
 #else
 	// Configure timers and legacy FIQ to be group 0
 	gicr_write32(GICR_IGROUPR0, 0x81FFFFFF);
